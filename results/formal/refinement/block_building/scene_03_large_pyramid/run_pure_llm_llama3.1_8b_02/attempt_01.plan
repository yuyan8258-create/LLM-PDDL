(pick-up b1)
(stack-bridge b1 m1 b2)
(pick-up b2)
(stack-bridge b2 m2 b3)
(pick-up b3)
(stack-bridge b3 m3 b4)
(pick-up m1)
(stack m1 b1)
(pick-up m2)
(stack m2 b2)
(pick-up m3)
(stack m3 b3)
(pick-up u1)
(stack-bridge u1 m1 m2)
(pick-up u2)
(stack-bridge u2 m2 m3)
(pick-up top)
(stack top u1)
(put-down top)
