(define (problem scene-03-large-pyramid)
  (:domain image_block_building)

  (:objects
    B1 B2 B3 B4 M1 M2 M3 U1 U2 top
  )

  (:init
    (ontable B1)
    (ontable B2)
    (ontable B3)
    (ontable B4)
    (ontable M1)
    (ontable M2)
    (ontable M3)
    (ontable U1)
    (ontable U2)
    (ontable top)
    (clear B1)
    (clear B2)
    (clear B3)
    (clear B4)
    (clear M1)
    (clear M2)
    (clear M3)
    (clear U1)
    (clear U2)
    (clear top)
    (handempty)
    (left-free B1)
    (left-free B2)
    (left-free B3)
    (left-free B4)
    (left-free M1)
    (left-free M2)
    (left-free M3)
    (left-free U1)
    (left-free U2)
    (left-free top)
    (right-free B1)
    (right-free B2)
    (right-free B3)
    (right-free B4)
    (right-free M1)
    (right-free M2)
    (right-free M3)
    (right-free U1)
    (right-free U2)
    (right-free top)
  )

  (:goal
    (and
      (on-bridge M1 B1 B2)
      (on-bridge M2 B2 B3)
      (on-bridge M3 B3 B4)
      (on-bridge U1 M1 M2)
      (on-bridge U2 M2 M3)
      (on-bridge top U1 U2)
      (ontable B1)
      (ontable B2)
      (ontable B3)
      (ontable B4)
      (handempty)
    )
  )
)
